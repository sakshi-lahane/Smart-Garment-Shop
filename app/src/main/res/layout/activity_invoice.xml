<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/mainInvoiceLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="16dp"
        android:elevation="6dp">

        <!-- Shop Name -->
        <TextView
            android:id="@+id/tvShopName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Shop"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#000"/>

        <TextView
            android:id="@+id/tvOwnerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Owner Name"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="#666"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000"/>

        <!-- Bill Info -->
        <TextView
            android:id="@+id/tvBillNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bill No: --"
            android:layout_marginTop="8dp"
            android:textColor="#000"/>

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date: --"
            android:textColor="#000"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000"
            android:layout_marginVertical="8dp"/>

        <!-- Customer Info -->
        <TextView
            android:id="@+id/tvCustomerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customer: --"
            android:textColor="#000"/>

        <TextView
            android:id="@+id/tvCustomerMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mobile: --"
            android:textColor="#000"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000"
            android:layout_marginVertical="8dp"/>

        <!-- Items Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:text="Item"
                android:textStyle="bold"/>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Qty"
                android:textStyle="bold"/>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Price"
                android:textStyle="bold"/>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Total"
                android:textStyle="bold"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000"
            android:layout_marginVertical="6dp"/>

        <!-- Items -->
        <LinearLayout
            android:id="@+id/itemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000"
            android:layout_marginVertical="8dp"/>

        <!-- Totals -->
        <TextView
            android:id="@+id/tvSubtotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subtotal: ₹0"
            android:textColor="#000"/>

        <TextView
            android:id="@+id/tvDiscount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Discount: ₹0"
            android:textColor="#000"/>

        <TextView
            android:id="@+id/tvFinalTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Final Total: ₹0"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#000"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000"
            android:layout_marginVertical="8dp"/>

        <TextView
            android:id="@+id/tvPaymentMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Payment: --"
            android:textColor="#000"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🤝 Thank you for shopping with us ❤️"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:textColor="#000"/>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/btnPrint"
                android:layout_height="48dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Print"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/orange_dark"/>

            <Button
                android:id="@+id/btnPdf"
                android:layout_height="48dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:text="PDF"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/orange_dark"/>

            <Button
                android:id="@+id/btnShare"
                android:layout_height="48dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Share"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/orange_dark"/>
        </LinearLayout>

    </LinearLayout>

</ScrollView>
