<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        tools:context=".Create_Bill_Form">

        <!-- Shop Name -->
        <TextView
            android:id="@+id/tvShopName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Garment Shop"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/orange_dark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Customer Details -->
        <TextView
            android:id="@+id/tvCustomerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer Details"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvShopName"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"/>

        <EditText
            android:id="@+id/etCustomerName"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:hint="Customer Name"
            android:background="@drawable/input_field_bg"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvCustomerLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/etCustomerMobile"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:hint="Mobile Number"
            android:inputType="phone"
            android:background="@drawable/input_field_bg"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/etCustomerName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <!-- Add Item -->
        <TextView
            android:id="@+id/tvItemLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Garment Item"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/etCustomerMobile"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"/>

        <!-- Search + Add Button -->
        <LinearLayout
            android:id="@+id/layoutAddItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvItemLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/etSearchItem"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:hint="Search Garment..."
                android:background="@drawable/input_field_bg"
                android:padding="12dp"/>

            <Button
                android:id="@+id/btnAddItem"
                android:layout_width="90dp"

                android:layout_height="50dp"
                android:text="ADD"
                android:textStyle="bold"
                android:backgroundTint="@color/orange_dark"
                android:textColor="@android:color/white"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Bill Items List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBillItems"
            android:layout_width="0dp"
            android:layout_height="240dp"
            android:background="#F5F5F5"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/layoutAddItem"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"/>

        <!-- Billing Summary -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTotalSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/rvBillItems"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Billing Summary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvSubtotal"
                    android:text="Subtotal: ₹0.00"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvGST"
                    android:text="GST (5%): ₹0.00"
                    android:layout_marginTop="4dp"/>

                <EditText
                    android:id="@+id/etDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Discount (₹ or %)"
                    android:background="@drawable/input_field_bg"
                    android:padding="10dp"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvGrandTotal"
                    android:text="Grand Total: ₹0.00"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"
                    android:gravity="center"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Payment Mode -->
        <Spinner
            android:id="@+id/spPaymentMode"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:background="@drawable/input_field_bg"
            app:layout_constraintTop_toBottomOf="@id/cardTotalSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="14dp"/>

        <!-- Generate Invoice -->
        <Button
            android:id="@+id/btnGenerateInvoice"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="Generate Invoice"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/orange_dark"
            android:textColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/spPaymentMode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
