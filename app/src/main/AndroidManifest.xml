        <activity
            android:name=".Product_List"
            android:exported="false" />
        <activity
            android:name=".Add_Stock"
            android:exported="false" />
        <activity
            android:name=".Create_Bill_Form"
            android:exported="false" />
        <activity
            android:name=".Forget_Password"
            android:exported="false" />
        <activity
