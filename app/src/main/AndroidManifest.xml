                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Welcome Screen -->
        <activity
            android:name=".Welcome_Page"
            android:exported="false" /> <!-- Main Activity (NO LAUNCHER) -->
